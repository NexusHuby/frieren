    ControlBg       = Color3.fromRGB(32,  32,  38 ),
    ControlBorder   = Color3.fromRGB(50,  50,  58 ),
    ControlHover    = Color3.fromRGB(38,  38,  45 ),
    ControlActive   = Color3.fromRGB(45,  45,  54 ),
    -- Toggle
    ToggleOff       = Color3.fromRGB(55,  55,  65 ),
    ToggleOn        = Color3.fromRGB(99,  102, 241),
    ToggleKnob      = Color3.fromRGB(220, 220, 230),
    -- Slider
    SliderTrack     = Color3.fromRGB(40,  40,  48 ),
    SliderFill      = Color3.fromRGB(99,  102, 241),
    SliderKnob      = Color3.fromRGB(255, 255, 255),
    -- Accent
    Accent          = Color3.fromRGB(99,  102, 241),
    AccentHover     = Color3.fromRGB(118, 120, 255),
    AccentText      = Color3.fromRGB(255, 255, 255),
    -- Text
    TextPrimary     = Color3.fromRGB(220, 220, 230),
    TextSecondary   = Color3.fromRGB(140, 140, 155),
