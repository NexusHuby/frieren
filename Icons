--[[
    NexusUI Icons Module
    Lucide-style SVG path data encoded for Roblox DrawingLib rendering.
    Each icon is a table of {path, viewBox} where path is a simplified
    set of line/curve commands translated into point arrays.

    Usage:
        local Icons = loadstring(game:HttpGet("https://raw.githubusercontent.com/YOUR_USER/YOUR_REPO/main/Icons.lua"))()
        local homeIcon = Icons.Home
        -- homeIcon.Points = array of Vector2 segments
        -- homeIcon.Size   = number (viewBox size, always 24)
]]

local Icons = {}

-- Each icon entry:
--   Points = { {Vector2, Vector2, ...}, ... }  -- sub-paths (line segments approximating the SVG path)
--   Size   = 24   (reference viewBox dimension; scale as needed)
-- Points are normalized to 0-1 range for easy scaling.

local function v(x, y) return Vector2.new(x / 24, y / 24) end

