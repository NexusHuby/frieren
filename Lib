            function section:CreateSlider(text, min, max, default, callback, precise)
                local slider = {Value = default or min}
                min, max = min or 0, max or 100

                local sliderFrame = Create("Frame", {
                    Parent = sectionContent,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 52),
                    LayoutOrder = #sectionContent:GetChildren()
                })

                local sliderLabel = Create("TextLabel", {
                    Parent = sliderFrame,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -60, 0, 20),
                    Font = Enum.Font.Gotham,
                    Text = text,
                    TextColor3 = Config.Theme.Text,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left
                })

                local valueLabel = Create("TextLabel", {
                    Parent = sliderFrame,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(0, 60, 0, 20),
                    Position = UDim2.new(1, -60, 0, 0),
                    Font = Enum.Font.GothamBold,
                    Text = tostring(slider.Value),
                    TextColor3 = Config.Theme.Accent,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Right
                })

                local track = Create("Frame", {
                    Parent = sliderFrame,
                    BackgroundColor3 = Config.Theme.Tertiary,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 6),
                    Position = UDim2.new(0, 0, 0, 34)
                })

                Create("UICorner", {Parent = track, CornerRadius = UDim.new(1, 0)})

                local fill = Create("Frame", {
                    Parent = track,
                    BackgroundColor3 = Config.Theme.Accent,
                    BorderSizePixel = 0,
                    Size = UDim2.new((slider.Value - min) / (max - min), 0, 1, 0)
                })

                Create("UICorner", {Parent = fill, CornerRadius = UDim.new(1, 0)})

                local handle = Create("Frame", {
                    Parent = track,
                    BackgroundColor3 = Config.Theme.Text,
                    BorderSizePixel = 0,
                    Size = UDim2.new(0, 14, 0, 14),
                    Position = UDim2.new((slider.Value - min) / (max - min), -7, 0.5, -7),
                    ZIndex = 2
                })

                Create("UICorner", {Parent = handle, CornerRadius = UDim.new(1, 0)})
                Create("UIStroke", {Parent = handle, Color = Config.Theme.Accent, Thickness = 2})

                local dragging = false

                local function Update(input)
                    local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                    local value
                    if precise then
                        value = min + (max - min) * pos
                        value = math.floor(value * 100) / 100
                    else
                        value = math.floor(min + (max - min) * pos)
                    end

                    if value ~= slider.Value then
                        slider.Value = value
                        valueLabel.Text = tostring(value)
                        fill.Size = UDim2.new(pos, 0, 1, 0)
                        handle.Position = UDim2.new(pos, -7, 0.5, -7)
                        if callback then callback(value) end
                    end
                end

                handle.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                    end
                end)

                track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        Update(input)
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        Update(input)
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)

                function slider:SetValue(val)
                    val = math.clamp(val, min, max)
                    slider.Value = val
                    local pos = (val - min) / (max - min)
                    valueLabel.Text = tostring(val)
                    fill.Size = UDim2.new(pos, 0, 1, 0)
                    handle.Position = UDim2.new(pos, -7, 0.5, -7)
                    if callback then callback(val) end
                end

                return slider
            end

