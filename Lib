                    TextXAlignment = Enum.TextXAlignment.Left
                })

                local keybindBtn = Create("TextButton", {
                    Parent = keybindFrame,
                    BackgroundColor3 = Config.Theme.Tertiary,
                    BorderSizePixel = 0,
                    Size = UDim2.new(0, 80, 0, 26),
                    Position = UDim2.new(1, -80, 0.5, -13),
                    Font = Enum.Font.GothamBold,
                    Text = keybind.Value and keybind.Value.Name or "None",
                    TextColor3 = Config.Theme.Text,
                    TextSize = 12,
                    AutoButtonColor = false
                })

                Create("UICorner", {Parent = keybindBtn, CornerRadius = UDim.new(0, 4)})

                local listening = false

                keybindBtn.MouseButton1Click:Connect(function()
                    listening = true
                    keybindBtn.Text = "..."
                    Tween(keybindBtn, {BackgroundColor3 = Config.Theme.Accent})
                end)

                UserInputService.InputBegan:Connect(function(input, gameProcessed)
                    if listening and not gameProcessed then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            if input.KeyCode == Enum.KeyCode.Escape then
                                keybind.Value = nil
                                keybindBtn.Text = "None"
                            else
                                keybind.Value = input.KeyCode
                                keybindBtn.Text = input.KeyCode.Name
                                if callback then callback(input.KeyCode) end
                            end
                            listening = false
                            Tween(keybindBtn, {BackgroundColor3 = Config.Theme.Tertiary})
                        end
                    elseif keybind.Value and input.KeyCode == keybind.Value and not gameProcessed then
                        if callback then callback(keybind.Value, true) end
                    end
                end)

                function keybind:SetValue(key)
                    keybind.Value = key
                    keybindBtn.Text = key and key.Name or "None"
                end

                return keybind
            end

