                -- RGB Sliders
                local sliders = {}
                local colors = {"R", "G", "B"}
                local colorValues = {picker.Value.R * 255, picker.Value.G * 255, picker.Value.B * 255}

                for i, color in ipairs(colors) do
                    local sliderFrame = Create("Frame", {
                        Parent = pickerContainer,
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 0, 28)
                    })

                    local label = Create("TextLabel", {
                        Parent = sliderFrame,
                        BackgroundTransparency = 1,
                        Size = UDim2.new(0, 20, 1, 0),
                        Font = Enum.Font.GothamBold,
                        Text = color,
                        TextColor3 = color == "R" and Color3.fromRGB(255, 100, 100) or color == "G" and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(100, 100, 255),
                        TextSize = 12
                    })

                    local track = Create("Frame", {
                        Parent = sliderFrame,
                        BackgroundColor3 = Config.Theme.Tertiary,
                        BorderSizePixel = 0,
                        Size = UDim2.new(1, -30, 0, 6),
                        Position = UDim2.new(0, 26, 0.5, -3)
                    })

                    Create("UICorner", {Parent = track, CornerRadius = UDim.new(1, 0)})

                    local fill = Create("Frame", {
                        Parent = track,
                        BackgroundColor3 = color == "R" and Color3.fromRGB(255, 0, 0) or color == "G" and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(0, 0, 255),
                        BorderSizePixel = 0,
                        Size = UDim2.new(colorValues[i] / 255, 0, 1, 0)
                    })

                    Create("UICorner", {Parent = fill, CornerRadius = UDim.new(1, 0)})

                    local handle = Create("Frame", {
                        Parent = track,
                        BackgroundColor3 = Config.Theme.Text,
                        BorderSizePixel = 0,
                        Size = UDim2.new(0, 12, 0, 12),
                        Position = UDim2.new(colorValues[i] / 255, -6, 0.5, -6)
                    })

                    Create("UICorner", {Parent = handle, CornerRadius = UDim.new(1, 0)})

                    local dragging = false

                    local function Update(input)
                        local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        local value = math.floor(pos * 255)
                        colorValues[i] = value
                        fill.Size = UDim2.new(pos, 0, 1, 0)
                        handle.Position = UDim2.new(pos, -6, 0.5, -6)

                        picker.Value = Color3.fromRGB(colorValues[1], colorValues[2], colorValues[3])
                        colorPreview.BackgroundColor3 = picker.Value
                        if callback then callback(picker.Value) end
                    end

                    track.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            dragging = true
                            Update(input)
                        end
                    end)

                    UserInputService.InputChanged:Connect(function(input)
                        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                            Update(input)
                        end
                    end)

                    UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 then
                            dragging = false
                        end
                    end)
                end

                local open = false
                colorPreview.MouseButton1Click:Connect(function()
                    open = not open
                    if open then
                        pickerContainer.Visible = true
                        pickerFrame.Size = UDim2.new(1, 0, 0, 62 + 110)
                        Tween(pickerContainer, {Size = UDim2.new(1, 0, 0, 104)})
                    else
                        Tween(pickerContainer, {Size = UDim2.new(1, 0, 0, 0)})
                        task.wait(0.2)
                        pickerContainer.Visible = false
                        pickerFrame.Size = UDim2.new(1, 0, 0, 62)
                    end
                end)

                function picker:SetValue(color)
                    picker.Value = color
                    colorPreview.BackgroundColor3 = color
                    colorValues = {color.R * 255, color.G * 255, color.B * 255}
                    if callback then callback(color) end
                end

                return picker
            end

